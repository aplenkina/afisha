<?php
$secret = static fn (string $name): string => addcslashes(
    trim(file_get_contents((getenv('SECRETS_DIR') ?: '/run/secrets').'/'.$name)),
    '"\\$'
);
?>
###> doctrine/doctrine-bundle ###
DATABASE_USER="<?= $secret('POSTGRES_USER') ?>"
DATABASE_PASSWORD="<?= $secret('POSTGRES_PASSWORD') ?>"
