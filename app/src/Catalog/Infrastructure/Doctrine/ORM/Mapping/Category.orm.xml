<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Catalog\Domain\Category" table="category">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <indexes>
        </indexes>

        <field name="name" length="64" />
        <field name="alias" length="64" />
        <field name="position" type="smallint">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="available" type="boolean">
            <options>
                <option name="default">false</option>
            </options>
        </field>
        <field name="createdAt" type="datetimetz_immutable" />

    </entity>
</doctrine-mapping>
