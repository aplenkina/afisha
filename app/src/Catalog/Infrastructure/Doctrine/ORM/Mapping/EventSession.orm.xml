<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Catalog\Domain\EventSession" table="event_session">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <indexes>
            <index name="idx_event_session_starts_at" columns="starts_at" />
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_event_session_event_starts_venue" columns="event_id,starts_at,venue_id" />
        </unique-constraints>

        <field name="startsAt" type="datetimetz_immutable" column="starts_at" />
        <field name="endsAt" type="datetimetz_immutable" column="ends_at" nullable="true" />
        <field name="venueId" type="integer" column="venue_id" nullable="true" />
        <field name="ticketUrl" column="ticket_url" length="512" nullable="true" />
        <field name="status" length="16" enum-type="App\Catalog\Domain\SessionStatus" />

        <many-to-one field="event" target-entity="App\Catalog\Domain\Event" inversed-by="sessions">
            <join-column name="event_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </entity>
</doctrine-mapping>
