<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Catalog\Domain\Event" table="event">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <indexes>
            <index name="idx_event_status" columns="status" />
            <index name="idx_event_city_category" columns="city_id,category_id" />
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_event_slug" columns="slug" />
            <unique-constraint name="uniq_event_source_external" columns="source_id,external_id" />
        </unique-constraints>

        <field name="title" length="255" />
        <field name="slug" length="255" />
        <field name="description" type="text" nullable="true" />
        <field name="categoryId" type="integer" column="category_id" />
        <field name="cityId" type="integer" column="city_id" />
        <field name="venueId" type="integer" column="venue_id" nullable="true" />
        <field name="priceMin" type="decimal" column="price_min" precision="10" scale="2" nullable="true" />
        <field name="priceMax" type="decimal" column="price_max" precision="10" scale="2" nullable="true" />
        <field name="isFree" type="boolean" column="is_free" />
        <field name="ageLimit" type="smallint" column="age_limit" nullable="true" />
        <field name="imageUrl" column="image_url" length="512" nullable="true" />
        <field name="sourceUrl" column="source_url" length="512" nullable="true" />
        <field name="ticketUrl" column="ticket_url" length="512" nullable="true" />
        <field name="status" length="16" enum-type="App\Catalog\Domain\EventStatus" />
        <field name="sourceId" type="integer" column="source_id" nullable="true" />
        <field name="externalId" column="external_id" length="128" nullable="true" />
        <field name="createdBy" type="integer" column="created_by" nullable="true" />
        <field name="createdAt" type="datetimetz_immutable" />
        <field name="updatedAt" type="datetimetz_immutable" />

        <one-to-many field="sessions" target-entity="App\Catalog\Domain\EventSession" mapped-by="event" orphan-removal="true">
            <cascade>
                <cascade-all />
            </cascade>
            <order-by>
                <order-by-field name="startsAt" direction="ASC" />
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
