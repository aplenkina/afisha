<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Identity\Domain\User" table="app_user">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        <unique-constraints>
            <unique-constraint name="uniq_app_user_email" columns="email" />
        </unique-constraints>

        <field name="email" length="180" />
        <field name="password" length="255" />
        <field name="role" length="32" enum-type="App\Identity\Domain\UserRole" />
        <field name="active" type="boolean" />
        <field name="createdAt" type="datetimetz_immutable" />
    </entity>
</doctrine-mapping>
