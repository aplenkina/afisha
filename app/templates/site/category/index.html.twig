{% extends 'site/calendar_layout.html.twig' %}

{% block title %}Категории — Афиша РБ{% endblock %}

{% block calendar_content %}
<main class="calendar-category">
    <h1 class="site-page-title">Категории</h1>

    {% if categories is empty %}
        <p class="site-muted">Категорий пока нет.</p>
    {% else %}
        <ul class="calendar-category-grid">
            {% for category in categories %}
                <li>
                    <a class="calendar-category-card" href="{{ path('category_page', { alias: category.alias }) }}">
                        <span class="calendar-category-card__title">{{ category.name }}</span>
                        <span class="calendar-category-card__meta">Смотреть события →</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</main>
{% endblock %}
