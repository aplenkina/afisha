{% extends 'base.html.twig' %}

{% block title %}Афиша РБ — календарь города{% endblock %}
{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
        try {
            document.documentElement.dataset.calendarTheme = localStorage.getItem('afisha-calendar-theme') === 'graphite' ? 'graphite' : 'light';
        } catch {
            document.documentElement.dataset.calendarTheme = 'light';
        }
    </script>
    <link rel="stylesheet" href="{{ asset('styles/calendar.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/footer.css') }}">
{% endblock %}

{% block body %}
    <div class="calendar site-page">
        <svg class="calendar-backdrop" viewBox="0 0 820 480" fill="none" aria-hidden="true" focusable="false">
            <path d="M818 22C676 3 626 43 612 106C599 169 678 197 755 173C816 154 808 94 752 81C679 64 637 111 644 172C650 238 582 283 486 273C380 262 309 309 340 367C367 417 455 376 463 329C472 274 405 254 327 273C231 296 210 393 104 424C68 435 35 438 2 434" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"/>
        </svg>
        <header class="calendar-header">
            {% include 'site/_brand.html.twig' with {className: 'calendar-logo'} only %}
            <div class="calendar-header-actions">
                <a href="{{ path('category_index') }}">Категории</a>
                <button class="calendar-theme" type="button" hidden>Ночь</button>
            </div>
        </header>
        <div class="site-page__content">
            {% block calendar_content %}{% endblock %}
        </div>
        {% include 'site/_footer.html.twig' only %}
    </div>
    <script>
        (() => {
            const root = document.documentElement;
            const button = document.querySelector('.calendar-theme');
            const render = () => {
                const night = root.dataset.calendarTheme === 'graphite';
                button.textContent = night ? 'День' : 'Ночь';
                button.setAttribute('aria-label', night ? 'День — включить дневную тему' : 'Ночь — включить ночную тему');
            };

            render();
            button.hidden = false;
            button.addEventListener('click', () => {
                const theme = root.dataset.calendarTheme === 'graphite' ? 'light' : 'graphite';
                root.dataset.calendarTheme = theme;
                render();
                try {
                    localStorage.setItem('afisha-calendar-theme', theme);
                } catch {}
            });
        })();
    </script>
{% endblock %}
