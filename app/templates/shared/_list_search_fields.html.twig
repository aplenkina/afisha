<div class="list-search__field">
    <label class="form-label" for="list-search-query">{{ label|default('Поиск по списку') }}</label>
    <input class="form-control" type="search" id="list-search-query" name="q" value="{{ search.query }}"
           maxlength="{{ constant('App\\Shared\\Presentation\\ListSearch::MAX_QUERY_LENGTH') }}" placeholder="{{ placeholder|default('Введите текст для поиска') }}"{% if search.error %} aria-invalid="true" aria-describedby="list-search-error"{% endif %}>
</div>
<label class="list-search__mode">
    <input class="form-check-input" type="checkbox" name="regex" value="1"{% if search.regex %} checked{% endif %}>
    Регулярное выражение
</label>
