{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Города' %}
{% block main %}
    <div class="admin-card">
        {% if cities is empty %}
            <p class="admin-empty">Городов пока нет.</p>
        {% else %}
            <ul class="admin-list">
                {% for city in cities %}
                    <li class="admin-list__item">
                        <div class="admin-list__main">
                            <a class="admin-list__title admin-list__row-link" href="{{ path('admin_city_details', { id: city.id }) }}">{{ city.name }}</a>
                            <span class="admin-list__meta">{{ city.slug }} · {{ city.available ? 'показывается на сайте' : 'скрыт' }}</span>
                        </div>
                        <div class="admin-list__actions">
                            <twig:ea:Button htmlElement="form" action="{{ path('admin_city_delete', { id: city.id }) }}" method="DELETE" variant="danger" class="admin-btn">Удалить</twig:ea:Button>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="admin-actions">
            <twig:ea:Button htmlElement="a" href="{{ path('admin_city_new') }}" icon="internal:plus" class="admin-btn">Добавить город</twig:ea:Button>
        </div>
    </div>
{% endblock %}
