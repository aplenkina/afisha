{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Площадки' %}
{% block main %}
    <div class="admin-card">
        <form method="GET" action="{{ path('admin_venue_index') }}" class="admin-form__field">
            <label class="admin-form__label form-label" for="city">Город</label>
            <select class="admin-form__input form-select" id="city" name="city" onchange="this.form.submit()">
                <option value="">Все города</option>
                {% for city in cities %}
                    <option value="{{ city.id }}" {{ cityId == city.id ? 'selected' : '' }}>{{ city.name }}</option>
                {% endfor %}
            </select>
        </form>

        {% if venues is empty %}
            <p class="admin-empty">Площадок пока нет.</p>
        {% else %}
            <ul class="admin-list">
                {% for venue in venues %}
                    <li class="admin-list__item">
                        <div class="admin-list__main">
                            <a class="admin-list__title admin-list__row-link" href="{{ path('admin_venue_details', { id: venue.id }) }}">{{ venue.name }}</a>
                            <span class="admin-list__meta">{{ venue.address }}</span>
                        </div>
                        <div class="admin-list__actions">
                            <twig:ea:Button htmlElement="form" action="{{ path('admin_venue_delete', { id: venue.id }) }}" method="DELETE" variant="danger" class="admin-btn">Удалить</twig:ea:Button>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="admin-actions">
            <twig:ea:Button htmlElement="a" href="{{ path('admin_venue_new') }}" icon="internal:plus" class="admin-btn">Добавить площадку</twig:ea:Button>
        </div>
    </div>
{% endblock %}
