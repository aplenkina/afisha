{% extends 'base.html.twig' %}

{% block title %}Вход · Афиша РБ{% endblock %}
{% block favicon %}{{ asset('favicon-admin.svg') }}{% endblock %}

{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
    <form class="admin-card admin-login" method="post" action="{{ path('admin_login') }}">
        {% include 'site/_brand.html.twig' with {className: 'admin-login-brand'} only %}
        <h1>Вход в админку</h1>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="admin-form__field">
            <label class="admin-form__label" for="username">Почта</label>
            <input class="admin-form__input" type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        </div>
        <div class="admin-form__field">
            <label class="admin-form__label" for="password">Пароль</label>
            <input class="admin-form__input" type="password" id="password" name="_password" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="admin-btn btn">Войти</button>
    </form>
{% endblock %}
