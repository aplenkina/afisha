{
	auto_https off
	skip_install_trust
	frankenphp

	log php_console {
		include frankenphp http.handlers.php
		output stderr
	}
	log php_journal {
		include frankenphp http.handlers.php
		output file /var/www/html/app/var/log/php.log {
			roll_size 5MiB
			roll_at 00:00
			roll_keep 7
			roll_keep_for 168h
			roll_uncompressed
		}
		format json
	}
}

:80 {
	import request-logs.caddyfile
	root * public/
	encode zstd br gzip
	request_body /healthz/report {
		max_size 1KiB
	}
	php_server
}
