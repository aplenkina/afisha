# Keep identity and request metadata without headers or query parameters.
@private_requests path /admin /admin/* /healthz/report /telegram/webhook
log_skip @private_requests
log_append <user_agent {http.request.header.User-Agent}

log public_requests {
	output file /var/www/html/app/var/log/access.log {
		roll_size 5MiB
		roll_at 00:00
		roll_keep 7
		roll_keep_for 168h
		roll_uncompressed
	}
	format filter {
		wrap json
		fields {
			request>headers delete
			request>tls delete
			request>remote_port delete
			resp_headers delete
			request>uri regexp "^([^?]{0,1000}).*$" "$1"
			user_agent regexp "(?s)^(.{0,512}).*$" "$1"
		}
	}
}
