FROM dunglas/frankenphp@sha256:667c5fffd348d9c3c260803d75956f1d9aace7e4b7331d8893de6f101d7e0e57

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/* \
    && install-php-extensions @composer pdo_pgsql

WORKDIR /var/www/html/app
ENV APP_ENV=prod APP_DEBUG=0 COMPOSER_ALLOW_SUPERUSER=1

COPY app/ ./
RUN touch .env \
    && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts \
    && php bin/console assets:install public \
    && php bin/console importmap:install \
    && php bin/console asset-map:compile

COPY docker/frankenphp/Caddyfile.prod /etc/caddy/Caddyfile
COPY docker/frankenphp/request-logs.caddyfile /etc/caddy/

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
